---
// Hero.astro
---

<section id="accueil" class="relative min-h-screen flex items-center justify-center overflow-hidden pt-20">

  <!-- Vidéo en fond -->
  <video
    src="/videos/douarnenez.mp4"
    autoplay
    muted
    loop
    playsinline
    class="absolute inset-0 w-full h-full object-cover opacity-70 grayscale"
  ></video>

  <!-- Voile clair pour garder le texte lisible -->
  <div class="absolute inset-0 bg-gradient-to-br from-neutral-50/70 to-primary-50/70"></div>

  <!-- Fondu au noir sur la boucle de la vidéo -->
  <div id="hero-fade" class="absolute inset-0 bg-black pointer-events-none" style="opacity:0"></div>

  <div class="container relative z-10 mx-auto px-6 py-12">
    <h1 class="text-5xl md:text-6xl lg:text-7xl font-lora font-bold text-primary-700 mb-6 leading-tight text-center drop-shadow-sm">
      Retrouvez votre <br class="block md:hidden" />
        <span class="text-accent-500">équilibre</span>
      grâce à l'hypnose
      <br />
      à <span class="text-accent-500">Douarnenez</span>
    </h1>

    <!-- Contenu texte -->
    <div class="text-center max-w-3xl mx-auto" data-aos="fade-up">

      <p class="text-xl md:text-2xl lg:text-3xl text-text-light mb-10 leading-relaxed">
        Bienvenue chez <strong>Clotilde</strong>, votre hypnothérapeute.
        Accompagnement bienveillant pour surmonter vos difficultés et retrouver votre bien-être.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#hypnose" class="bg-primary-500 text-white px-8 py-4 rounded-full hover:bg-primary-600 transition-all duration-300 font-semibold shadow-lg hover:shadow-xl transform hover:-translate-y-1">
          Découvrir l'hypnose
        </a>
        <a href="#contact" class="border-2 border-primary-500 text-primary-500 bg-white/60 px-8 py-4 rounded-full hover:bg-primary-500 hover:text-white transition-all duration-300 font-semibold">
          Prendre rendez-vous
        </a>
      </div>
    </div>

    <!-- Indicateur de scroll -->
    <!-- <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
      <a href="#hypnose" class="text-primary-500 hover:text-primary-600 transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </a>
    </div> -->
    <div class="mouse-wheel" aria-hidden="true">
      <div class="wheel"></div>
    </div>
  </div>
</section>

<script>
  // Fondu au noir doux à chaque boucle de la vidéo de fond
  const section = document.getElementById('accueil');
  const video = section?.querySelector('video');
  const fade = document.getElementById('hero-fade');
  const FADE = 0.8; // durée du fondu (en secondes) de chaque côté de la boucle

  if (video && fade) {
    const update = () => {
      const d = video.duration;
      if (d && !Number.isNaN(d)) {
        const t = video.currentTime;
        let o = 0;
        if (t < FADE) o = 1 - t / FADE;                 // fondu depuis le noir (début)
        else if (d - t < FADE) o = 1 - (d - t) / FADE;  // fondu vers le noir (fin)
        fade.style.opacity = o.toFixed(3);
      }
      requestAnimationFrame(update);
    };
    requestAnimationFrame(update);
  }
</script>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
  }

  .animate-float {
    animation: float 3s ease-in-out infinite;
  }

  /* --- Indicateur de défilement stylisé : Souris ---*/
.mouse-wheel {
  position: fixed;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%);
  width: 30px;
  height: 50px;
  border: 2px solid #4A664A;;
  border-radius: 15px;
  display: flex;
  justify-content: center;
  align-items: start;
  opacity: 0.7;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.mouse-wheel:hover {
  opacity: 1;
}

.wheel {
  width: 4px;
  height: 10px;
  background-color: #4A664A;
  border-radius: 2px;
  margin-top: 10px;
  animation: scrollWheel 1.5s infinite;
}

/* Animation de la molette */
@keyframes scrollWheel {
  0% {
    transform: translateY(0);
    opacity: 1;
  }
  100% {
    transform: translateY(20px);
    opacity: 0;
  }
}

/* Accessibilité : réduire les animations si demandé */
@media (prefers-reduced-motion: reduce) {
  .wheel {
    animation: none;
  }
}
</style>
