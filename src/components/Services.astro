---
// Services.astro
---

<section id="services" class="py-20 bg-gradient-to-br from-neutral-50 to-primary-50">
  <div class="container mx-auto px-6">
    <div class="max-w-4xl mx-auto text-center mb-16" data-aos="fade-up">
      <h2 class="text-3xl md:text-4xl font-lora font-bold text-primary-700 mb-6">
        Problématiques accompagnées
      </h2>
      <div class="w-20 h-1 bg-accent-500 mx-auto mb-8"></div>
      <p class="text-lg text-text-light max-w-2xl mx-auto">
        L'hypnose thérapeutique peut vous accompagner dans de nombreuses situations.
        Cliquez sur une carte pour en savoir plus.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-12 gap-8">

      <!-- Carte Arrêt du tabac -->
      <div class="service-card lg:col-span-4 bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 cursor-pointer transform hover:-translate-y-2 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2" role="button" tabindex="0" aria-haspopup="dialog"
           data-aos="fade-up" data-aos-delay="100" data-service="tabac">
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-6 bg-gradient-to-br from-red-400 to-red-600 rounded-full flex items-center justify-center shadow-lg">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728L5.636 5.636m12.728 12.728L5.636 5.636"></path>
            </svg>
          </div>
          <h3 class="text-xl font-lora font-bold text-primary-700 mb-4">Arrêt du tabac</h3>
          <p class="text-text-light">Libérez-vous de la dépendance au tabac de manière naturelle et durable.</p>
        </div>
      </div>

      <!-- Carte Diminution des douleurs -->
      <div class="service-card lg:col-span-4 bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 cursor-pointer transform hover:-translate-y-2 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2" role="button" tabindex="0" aria-haspopup="dialog"
           data-aos="fade-up" data-aos-delay="150" data-service="douleurs">
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-6 bg-gradient-to-br from-amber-400 to-amber-600 rounded-full flex items-center justify-center shadow-lg">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-lora font-bold text-primary-700 mb-4">Diminution des douleurs</h3>
          <p class="text-text-light">Atténuez vos douleurs chroniques pour une vie plus sereine.</p>
        </div>
      </div>

      <!-- Carte Accompagnement du deuil -->
      <div class="service-card lg:col-span-4 bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 cursor-pointer transform hover:-translate-y-2 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2" role="button" tabindex="0" aria-haspopup="dialog"
           data-aos="fade-up" data-aos-delay="200" data-service="deuil">
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-6 bg-gradient-to-br from-purple-400 to-purple-600 rounded-full flex items-center justify-center shadow-lg">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-lora font-bold text-primary-700 mb-4">Accompagnement du deuil</h3>
          <p class="text-text-light">Un soutien bienveillant pour traverser cette épreuve difficile.</p>
        </div>
      </div>

      <!-- Carte Sommeil -->
      <div class="service-card lg:col-span-3 bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 cursor-pointer transform hover:-translate-y-2 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2" role="button" tabindex="0" aria-haspopup="dialog"
           data-aos="fade-up" data-aos-delay="250" data-service="sommeil">
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-6 bg-gradient-to-br from-indigo-400 to-indigo-600 rounded-full flex items-center justify-center shadow-lg">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21.752 15.002A9.72 9.72 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-lora font-bold text-primary-700 mb-4">Retrouvez un sommeil apaisé</h3>
          <p class="text-text-light">Renouez avec des nuits paisibles et un endormissement plus serein.</p>
        </div>
      </div>

      <!-- Carte Traumas -->
      <div class="service-card lg:col-span-3 bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 cursor-pointer transform hover:-translate-y-2 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2" role="button" tabindex="0" aria-haspopup="dialog"
           data-aos="fade-up" data-aos-delay="300" data-service="trauma">
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-6 bg-gradient-to-br from-teal-400 to-teal-600 rounded-full flex items-center justify-center shadow-lg">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-lora font-bold text-primary-700 mb-4">Les traumas</h3>
          <p class="text-text-light">Un accompagnement doux, avec la technique IMO, pour dépasser un choc ou un événement marquant.</p>
        </div>
      </div>

      <!-- Carte Gestion du poids -->
      <div class="service-card lg:col-span-3 bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 cursor-pointer transform hover:-translate-y-2 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2" role="button" tabindex="0" aria-haspopup="dialog"
           data-aos="fade-up" data-aos-delay="350" data-service="poids">
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-6 bg-gradient-to-br from-pink-400 to-pink-600 rounded-full flex items-center justify-center shadow-lg">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"></path>
            </svg>
          </div>
          <h3 class="text-xl font-lora font-bold text-primary-700 mb-4">Gestion du poids</h3>
          <p class="text-text-light">Régulez votre poids de manière durable et bienveillante.</p>
        </div>
      </div>

      <!-- Carte Anxiété et phobies -->
      <div class="service-card lg:col-span-3 bg-white rounded-2xl p-8 shadow-lg hover:shadow-xl transition-all duration-300 cursor-pointer transform hover:-translate-y-2 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2" role="button" tabindex="0" aria-haspopup="dialog"
           data-aos="fade-up" data-aos-delay="400" data-service="anxiete-phobies">
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-6 bg-gradient-to-br from-blue-400 to-blue-600 rounded-full flex items-center justify-center shadow-lg">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-lora font-bold text-primary-700 mb-4">Anxiété et phobies</h3>
          <p class="text-text-light">Apaisez vos angoisses et libérez-vous de vos peurs au quotidien.</p>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Modal pour les détails des services -->
<div id="service-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" aria-hidden="true" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 opacity-0 invisible transition-all duration-300">
  <div class="relative bg-white rounded-2xl p-8 max-w-md mx-4 transform scale-95 transition-transform duration-300">
    <button id="modal-close" aria-label="Fermer" class="absolute top-4 right-4 w-9 h-9 flex items-center justify-center rounded-full text-text-light hover:text-primary-700 hover:bg-primary-50 transition-colors">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <div class="text-center">
      <div id="modal-icon" class="w-16 h-16 mx-auto mb-6 rounded-full flex items-center justify-center shadow-lg">
        <!-- Icône dynamique -->
      </div>
      <h3 id="modal-title" class="text-2xl font-lora font-bold text-primary-700 mb-4"></h3>
      <p id="modal-description" class="text-text-light mb-6 leading-relaxed"></p>
      <button id="modal-contact" class="w-full bg-primary-500 text-white px-6 py-3 rounded-full hover:bg-primary-600 transition-colors font-semibold">
        Je souhaite être accompagné(e)
      </button>
    </div>
  </div>
</div>

<script>
  // Données des services
  const serviceData = {
    tabac: {
      title: "Arrêt du tabac",
      description: "L'hypnose est particulièrement efficace pour l'arrêt du tabac. En une à trois séances, elle permet de se défaire de cette dépendance en agissant sur les mécanismes inconscients qui maintiennent l'habitude de fumer.",
      icon: '<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728L5.636 5.636m12.728 12.728L5.636 5.636"></path></svg>',
      color: "from-red-400 to-red-600"
    },
    douleurs: {
      title: "Diminution des douleurs",
      description: "L'hypnose permet de réduire les douleurs en agissant sur le cortex cingulaire antérieur. Elle permet d'améliorer la qualité de vie au quotidien.",
      icon: '<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>',
      color: "from-amber-400 to-amber-600"
    },
    deuil: {
      title: "Accompagnement du deuil",
      description: "Le processus de deuil est unique pour chacun. L'hypnose offre un accompagnement bienveillant pour traverser cette épreuve, honorer la mémoire du défunt et retrouver un équilibre émotionnel.",
      icon: '<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>',
      color: "from-purple-400 to-purple-600"
    },
    sommeil: {
      title: "Retrouvez un sommeil apaisé",
      description: "Les troubles du sommeil sont souvent liés à un mental en sur-activité. L'hypnose aide à apaiser ce mental, à relâcher les tensions accumulées dans la journée et à retrouver un endormissement naturel, pour des nuits plus réparatrices.",
      icon: '<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21.752 15.002A9.72 9.72 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"></path></svg>',
      color: "from-indigo-400 to-indigo-600"
    },
    trauma: {
      title: "Les traumas",
      description: "L'hypnose, associée à l'IMO (Intégration par le Mouvement Oculaire, une technique proche de l'EMDR), permet de retraiter en douceur les souvenirs traumatiques. Cet accompagnement aide à désamorcer la charge émotionnelle liée à l'événement et à retrouver un sentiment de sécurité intérieure.",
      icon: '<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>',
      color: "from-teal-400 to-teal-600"
    },
    poids: {
      title: "Gestion du poids",
      description: "L'hypnose permet de réguler votre poids en agissant sur les comportements alimentaires et en renforçant la motivation à adopter un mode de vie sain.",
      icon: '<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"></path></svg>',
      color: "from-pink-400 to-pink-600"
    },
    "anxiete-phobies": {
      title: "Anxiété et phobies",
      description: "L'hypnose aide à calmer l'anxiété du quotidien comme les peurs plus spécifiques (phobies). En travaillant sur les mécanismes inconscients à l'origine de ces réactions, elle permet de retrouver calme, confiance et liberté face aux situations redoutées.",
      icon: '<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>',
      color: "from-blue-400 to-blue-600"
    }
  };

  // Gestion des modals
  const modal = document.getElementById('service-modal');
  const modalTitle = document.getElementById('modal-title');
  const modalDescription = document.getElementById('modal-description');
  const modalIcon = document.getElementById('modal-icon');
  const modalClose = document.getElementById('modal-close');
  const modalContact = document.getElementById('modal-contact');

  let lastTrigger = null;

  function openModal(card) {
    const service = card.dataset.service;
    const data = serviceData[service];
    if (!data) return;

    lastTrigger = card;
    modalTitle.textContent = data.title;
    modalDescription.textContent = data.description;
    modalIcon.innerHTML = data.icon;
    modalIcon.className = `w-16 h-16 mx-auto mb-6 bg-gradient-to-br ${data.color} rounded-full flex items-center justify-center shadow-lg`;

    modal.classList.remove('opacity-0', 'invisible');
    modal.querySelector('div').classList.remove('scale-95');
    modal.setAttribute('aria-hidden', 'false');
    modalClose?.focus();
  }

  // Ouvrir : clic + clavier (Entrée / Espace)
  document.querySelectorAll('.service-card').forEach(card => {
    card.addEventListener('click', () => openModal(card));
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openModal(card);
      }
    });
  });

  // Fermer modal : bouton, clic sur le fond, touche Échap
  modalClose?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('invisible')) {
      closeModal();
    }
  });

  function closeModal() {
    modal?.classList.add('opacity-0', 'invisible');
    modal?.querySelector('div').classList.add('scale-95');
    modal?.setAttribute('aria-hidden', 'true');
    lastTrigger?.focus();
    lastTrigger = null;
  }

  // Contact depuis modal
  modalContact?.addEventListener('click', () => {
    closeModal();
    document.getElementById('contact')?.scrollIntoView({ behavior: 'smooth' });
  });
</script>
