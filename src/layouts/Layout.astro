---
export interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Hypnothérapeute à Douarnenez (Finistère). Accompagnement en hypnose pour l'arrêt du tabac, l'anxiété, le sommeil, les phobies et le deuil.",
  image = "/images/clotilde.jpeg",
} = Astro.props;

const SITE_NAME = "Cabinet d'hypnose de Clotilde";

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

// Données structurées pour le SEO local (schema.org).
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: SITE_NAME,
  description,
  url: Astro.site?.toString(),
  image: ogImage.toString(),
  telephone: "+33652251720",
  email: "info@hypnoclo.fr",
  address: {
    "@type": "PostalAddress",
    streetAddress: "65 Rue ar Véret",
    postalCode: "29100",
    addressLocality: "Douarnenez",
    addressRegion: "Bretagne",
    addressCountry: "FR",
  },
  geo: { "@type": "GeoCoordinates", latitude: 48.0904, longitude: -4.3361 },
  areaServed: "Douarnenez, Finistère",
  priceRange: "60-80 €",
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "Saturday",
      opens: "09:00",
      closes: "12:00",
    },
  ],
};
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#6B8E6B" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Fonts : chargement asynchrone pour ne pas bloquer le rendu initial -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&family=Lora:wght@400;500;600&display=swap">
  <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&family=Lora:wght@400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
  <noscript><link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300;400;500;600;700&family=Lora:wght@400;500;600&display=swap" rel="stylesheet"></noscript>

  <!-- Données structurées (SEO local) -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body class="font-quicksand">
  <a
    href="#accueil"
    class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:bg-primary-600 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg"
  >
    Aller au contenu
  </a>
  <slot />

  <!-- Script AOS avec import -->
  <script>
    import AOS from 'aos';
    import 'aos/dist/aos.css';

    // Initialiser AOS
    AOS.init({
      duration: 800,
      easing: 'ease-in-out',
      once: true,
      offset: 100,
      delay: 100
    });

    // Filet de sécurité : AOS s'appuie sur l'événement "scroll" (limité à un
    // appel toutes les 99ms), qui peut être manqué lors d'un défilement rapide
    // ou d'un "fling" tactile (le contenu reste alors invisible, opacity: 0).
    // Un IntersectionObserver garantit l'affichage dès qu'un élément entre
    // réellement dans la zone visible, quelle que soit la vitesse de défilement.
    const aosSafetyNet = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('aos-animate');
            aosSafetyNet.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -10% 0px' }
    );
    document.querySelectorAll('[data-aos]').forEach((el) => aosSafetyNet.observe(el));
  </script>
</body>
</html>

<style is:global>
  :root {
    --color-primary: #6B8E6B;
    --color-secondary: #A8C4A8;
    --color-accent: #8FBC8F;
    --color-neutral: #F5F5F0;
    --color-text: #2C3E2C;
    --color-text-light: #5A6B5A;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Quicksand', sans-serif;
    line-height: 1.6;
    color: var(--color-text);
    background-color: var(--color-neutral);
    overflow-x: hidden;
  }

  .font-lora {
    font-family: 'Lora', serif;
  }

  .font-quicksand {
    font-family: 'Quicksand', sans-serif;
  }

  html {
    scroll-behavior: smooth;
    overflow-x: hidden;
  }

  /* Scrollbar personnalisée */
  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    background: var(--color-neutral);
  }

  ::-webkit-scrollbar-thumb {
    background: var(--color-primary);
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--color-secondary);
  }
</style>
